# Database connection string
# For local SQLite zero-dependency execution:
DATABASE_URL="file:./dev.db"

# For PostgreSQL production deployment:
# DATABASE_URL="postgresql://meento_user:securepassword@localhost:5432/meentodb?schema=public"

# App base URL (for generating live QR codes and public links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Auth Secret for staff/admin sessions
JWT_SECRET="meento-secure-development-jwt-secret-key-32chars"

# Node Environment
NODE_ENV="development"
