datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String?           @unique
  phone            String?
  role             String            @default("CUSTOMER") // CUSTOMER, STAFF, ADMIN
  passwordHash     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  staffMemberships StaffMembership[]
  countersAssigned ServiceCounter[]  @relation("CurrentCounterStaff")
  queueEntries     QueueEntry[]
  serviceRecords   ServiceRecord[]
  notifications    Notification[]

  @@index([role])
}

model Business {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  venues       Venue[]
}

model Venue {
  id          String           @id @default(uuid())
  businessId  String
  name        String
  code        String           @unique
  address     String?
  phone       String?
  isOpen      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  queues      Queue[]
  counters    ServiceCounter[]
  staff       StaffMembership[]

  @@index([businessId])
}

model StaffMembership {
  id        String   @id @default(uuid())
  userId    String
  venueId   String
  roleTitle String   @default("Service Executive")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([venueId])
}

model ServiceCounter {
  id             String         @id @default(uuid())
  venueId        String
  counterNumber  Int
  name           String
  description    String?
  status         String         @default("OPEN") // OPEN, BUSY, CLOSED
  currentStaffId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  venue          Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  currentStaff   User?          @relation("CurrentCounterStaff", fields: [currentStaffId], references: [id], onDelete: SetNull)
  queueEntries   QueueEntry[]   @relation("CounterTokens")
  serviceRecords ServiceRecord[]

  @@unique([venueId, counterNumber])
  @@index([venueId])
}

model Queue {
  id                          String       @id @default(uuid())
  venueId                     String
  name                        String
  code                        String       @unique
  description                 String?
  prefix                      String       @default("Q")
  maxCapacity                 Int          @default(100)
  status                      String       @default("OPEN") // OPEN, PAUSED, CLOSED
  estimatedServiceTimeMinutes Int          @default(5)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  venue                       Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  entries                     QueueEntry[]

  @@index([venueId])
}

model QueueEntry {
  id                 String          @id @default(uuid())
  queueId            String
  userId             String?
  tokenNumber        Int
  formattedCode      String
  customerName       String
  customerPhone      String
  status             String          @default("WAITING") // WAITING, CALLED, SERVING, COMPLETED, CANCELLED, NO_SHOW
  counterId          String?
  joinedAt           DateTime        @default(now())
  calledAt           DateTime?
  servedAt           DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  priority           Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  queue              Queue           @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  counter            ServiceCounter? @relation("CounterTokens", fields: [counterId], references: [id], onDelete: SetNull)
  events             QueueEvent[]
  serviceRecord      ServiceRecord?
  notifications      Notification[]

  @@unique([queueId, tokenNumber])
  @@index([queueId, status])
  @@index([customerPhone])
}

model QueueEvent {
  id           String      @id @default(uuid())
  queueEntryId String
  eventType    String      // JOINED, CALLED, SERVING_STARTED, COMPLETED, CANCELLED, NO_SHOW
  counterId    String?
  staffId      String?
  details      String?
  createdAt    DateTime    @default(now())

  queueEntry   QueueEntry  @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)

  @@index([queueEntryId])
}

model ServiceRecord {
  id              String         @id @default(uuid())
  queueEntryId    String         @unique
  counterId       String
  staffId         String
  durationSeconds Int
  startedAt       DateTime
  completedAt     DateTime       @default(now())
  notes           String?
  createdAt       DateTime       @default(now())

  queueEntry      QueueEntry     @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  counter         ServiceCounter @relation(fields: [counterId], references: [id], onDelete: Cascade)
  staff           User           @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([counterId])
  @@index([staffId])
  @@index([completedAt])
}

model Notification {
  id           String      @id @default(uuid())
  queueEntryId String
  userId       String?
  title        String
  message      String
  isRead       Boolean     @default(false)
  sentAt       DateTime    @default(now())

  queueEntry   QueueEntry  @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([queueEntryId])
  @@index([userId])
}
